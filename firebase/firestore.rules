rules_version = '2';

// The API uses the Admin SDK, which bypasses these rules.
// These rules only govern the dashboard (signed-in admin in the browser).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Written by the API only; read-only for the dashboard.
      match /messages/{id} { allow read: if isOwner(uid); }
      match /activity/{id} { allow read: if isOwner(uid); }
      match /chats/{id}    { allow read: if isOwner(uid); }
      match /cities/{id}   { allow read: if isOwner(uid); }
      match /search/{id}   { allow read: if isOwner(uid); }

      // The admin edits these from the dashboard (approve leads, add notes, block contacts).
      match /campaigns/{id} { allow read, write: if isOwner(uid); }
      match /leads/{id}     { allow read, write: if isOwner(uid); }
      match /dnc/{id}       { allow read, write: if isOwner(uid); }
      match /settings/{id}  { allow read, write: if isOwner(uid); }
    }
  }
}

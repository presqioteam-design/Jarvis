# Your Firebase Auth UID (Firebase console → Authentication → Users)
JARVIS_UID=

# Service-account key downloaded from Firebase (keep it out of git)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# ActivityWatch runs locally on this port by default
AW_URL=http://localhost:5600

# How often to sync, in seconds
SYNC_INTERVAL=300

TIMEZONE=Asia/Kolkata

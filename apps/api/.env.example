# Your Firebase Auth UID — the only user this API serves
JARVIS_UID=
TIMEZONE=Asia/Kolkata

# Paste the whole service-account JSON on one line (Render),
# or leave empty and set GOOGLE_APPLICATION_CREDENTIALS to a file path (local dev)
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://jarvis.pages.dev

# Shared with the Cloudflare cron worker
CRON_SECRET=change-me

# anthropic | gemini | ollama
LLM_PROVIDER=anthropic
# Leave empty to use the provider default in app/services/llm.py
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-too

# Nudge when you switch apps this many times in 30 minutes
FOCUS_SWITCH_THRESHOLD=12

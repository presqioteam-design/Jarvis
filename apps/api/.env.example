# Your Firebase Auth UID — the admin this API serves (sign in to the dashboard once, then copy it)
JARVIS_UID=
TIMEZONE=Asia/Kolkata

# Paste the whole service-account JSON on one line (Render),
# or leave empty and set GOOGLE_APPLICATION_CREDENTIALS to a file path (local dev)
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,https://jarvis.pages.dev

# Shared with the Cloudflare cron worker
CRON_SECRET=change-me

# gemini (free tier) | anthropic
LLM_PROVIDER=gemini
# Leave empty to use the provider default in app/services/llm.py
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Hotel search (developer.tomtom.com, free, no card)
TOMTOM_API_KEY=

# Gmail account used for outreach, with an App Password (myaccount.google.com/apppasswords)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Telegram bot for alerts and chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-too

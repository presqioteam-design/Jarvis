{
  "name": "jarvis",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/frontend",
    "apps/cron",
    "packages/*"
  ],
  "scripts": {
    "ui:dev": "yarn workspace frontend dev",
    "ui:build": "yarn workspace frontend build",
    "api:dev": "cd apps/api && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "cron:dev": "yarn workspace cron dev",
    "cron:deploy": "yarn workspace cron deploy",
    "typecheck": "yarn workspaces run typecheck"
  }
}
